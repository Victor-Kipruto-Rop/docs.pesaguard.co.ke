{
  "note": "Mirrors the paths published by a running deployment's /openapi.json. Summaries are quoted from that document; the deployment is authoritative.",
  "specVersion": "2.0.0",
  "basePath": "/api/v1",
  "endpoints": [
    { "method": "GET", "path": "/tenant/current", "summary": "Get current tenant configuration", "status": "live" },
    { "method": "GET", "path": "/tenant/current/locale", "summary": "Get effective tenant locale", "status": "live" },
    { "method": "POST", "path": "/tenant/current/locale", "summary": "Update tenant locale", "status": "live" },
    { "method": "POST", "path": "/tenant/current/user-locale", "summary": "Set or clear a user locale override", "status": "live" },
    { "method": "GET", "path": "/providers", "summary": "List payment providers", "status": "live" },
    { "method": "POST", "path": "/providers", "summary": "Register a payment provider", "status": "live" },
    { "method": "GET", "path": "/providers/{provider_id}", "summary": "Get provider details", "status": "live" },
    { "method": "PATCH", "path": "/providers/{provider_id}", "summary": "Update provider configuration", "status": "live" },
    { "method": "POST", "path": "/providers/{provider_id}/connection", "summary": "Update provider connection status", "status": "live" },
    { "method": "POST", "path": "/providers/{provider_id}/health", "summary": "Update provider health status", "status": "live" },
    { "method": "GET", "path": "/discrepancies", "summary": "List discrepancies with advanced filters", "status": "live" },
    { "method": "POST", "path": "/discrepancies/{discrepancy_id}/resolve", "summary": "Resolve single discrepancy", "status": "live" },
    { "method": "POST", "path": "/discrepancies/bulk-resolve", "summary": "Bulk resolve discrepancies", "status": "live" },
    { "method": "GET", "path": "/api/v1/communications/templates", "summary": "List tenant communication templates", "status": "live" },
    { "method": "POST", "path": "/api/v1/communications/templates", "summary": "Create a draft communication template", "status": "live" },
    { "method": "POST", "path": "/api/v1/communications/templates/{template_id}/approve", "summary": "Approve a communication template version", "status": "live" },
    { "method": "PUT", "path": "/api/v1/communications/preferences/{recipient}", "summary": "Update recipient preferences and quiet hours", "status": "live" },
    { "method": "PUT", "path": "/api/v1/communications/consent/{recipient}", "summary": "Grant or revoke channel consent", "status": "live" },
    { "method": "POST", "path": "/api/v1/communications/otp", "summary": "Issue an OTP challenge", "status": "live" },
    { "method": "POST", "path": "/api/v1/communications/otp/{challenge_id}/verify", "summary": "Verify an OTP challenge", "status": "live" },
    { "method": "POST", "path": "/api/v1/communications/campaigns", "summary": "Create a bulk or scheduled campaign", "status": "live" },
    { "method": "GET", "path": "/api/v1/communications/analytics", "summary": "Get tenant communication delivery analytics", "status": "live" },
    { "method": "GET", "path": "/api/v1/communications/search", "summary": "Search tenant notifications", "status": "live" },
    { "method": "GET", "path": "/api/v1/communications/export", "summary": "Export tenant communications as CSV", "status": "live" },
    { "method": "GET", "path": "/health", "summary": "Service health", "status": "live" },
    { "method": "GET", "path": "/metrics", "summary": "Operational metrics", "status": "live" },
    { "method": "GET", "path": "/openapi.json", "summary": "OpenAPI document", "status": "live" }
  ]
}