{
  "name": "pesaguard-docs",
  "version": "1.0.0",
  "private": true,
  "description": "PesaGuard developer documentation",
  "scripts": {
    "serve": "python -m http.server 4173 --directory .",
    "check": "node scripts/check-docs.js && node scripts/validate-openapi.js",
    "check:openapi": "node scripts/validate-openapi.js",
    "check:drift": "node scripts/check-drift.js",
    "check:strict": "node scripts/check-docs.js && node scripts/validate-openapi.js --strict && node scripts/check-drift.js --strict",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
