{
  "openapi": "3.0.3",
  "info": {
    "title": "PesaGuard Dashboard & Reconciliation API",
    "version": "2.0.0",
    "description": "PesaGuard API contract metadata and hand-maintained operation summaries for the implementation-derived route inventory. The deployed /openapi.json is authoritative for a specific environment; generated route coverage must be refreshed from the canonical backend before use.",
    "x-documentation": "https://docs.pesaguard.co.ke/api/"
  },
  "servers": [
    {
      "url": "https://api.pesaguard.co.ke",
      "description": "PesaGuard API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request or query parameter."
      },
      "Unauthorized": {
        "description": "Authentication failed."
      },
      "Forbidden": {
        "description": "Insufficient permissions or tenant scope."
      },
      "RateLimited": {
        "description": "Rate limit exceeded."
      }
    },
    "parameters": {
      "ProviderId": {
        "name": "provider_id",
        "in": "path",
        "required": true,
        "description": "Identifier of the payment provider.",
        "schema": {
          "type": "string"
        }
      },
      "DiscrepancyId": {
        "name": "discrepancy_id",
        "in": "path",
        "required": true,
        "description": "Identifier of the discrepancy.",
        "schema": {
          "type": "string"
        }
      },
      "TemplateId": {
        "name": "template_id",
        "in": "path",
        "required": true,
        "description": "Identifier of the communication template.",
        "schema": {
          "type": "string"
        }
      },
      "Recipient": {
        "name": "recipient",
        "in": "path",
        "required": true,
        "description": "Recipient the preference or consent applies to.",
        "schema": {
          "type": "string"
        }
      },
      "ChallengeId": {
        "name": "challenge_id",
        "in": "path",
        "required": true,
        "description": "Identifier of the OTP challenge.",
        "schema": {
          "type": "string"
        }
      }
    }
  },
  "paths": {
    "/tenant/current": {
      "get": {
        "summary": "Get current tenant configuration",
        "responses": {
          "200": {
            "description": "Tenant configuration"
          }
        }
      }
    },
    "/tenant/current/locale": {
      "get": {
        "summary": "Get effective tenant locale",
        "responses": {
          "200": {
            "description": "Locale configuration"
          }
        }
      },
      "post": {
        "summary": "Update tenant locale",
        "responses": {
          "200": {
            "description": "Locale updated"
          }
        }
      }
    },
    "/tenant/current/user-locale": {
      "post": {
        "summary": "Set or clear a user locale override",
        "responses": {
          "200": {
            "description": "User locale updated"
          }
        }
      }
    },
    "/providers": {
      "get": {
        "summary": "List payment providers",
        "responses": {
          "200": {
            "description": "Provider list"
          }
        }
      },
      "post": {
        "summary": "Register a payment provider",
        "responses": {
          "201": {
            "description": "Provider registered"
          }
        }
      }
    },
    "/providers/{provider_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProviderId"
        }
      ],
      "get": {
        "summary": "Get provider details",
        "responses": {
          "200": {
            "description": "Provider details"
          }
        }
      },
      "patch": {
        "summary": "Update provider configuration",
        "responses": {
          "200": {
            "description": "Provider updated"
          }
        }
      }
    },
    "/providers/{provider_id}/connection": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProviderId"
        }
      ],
      "post": {
        "summary": "Update provider connection status",
        "responses": {
          "200": {
            "description": "Connection status updated"
          }
        }
      }
    },
    "/providers/{provider_id}/health": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProviderId"
        }
      ],
      "post": {
        "summary": "Update provider health status",
        "responses": {
          "200": {
            "description": "Health status updated"
          }
        }
      }
    },
    "/discrepancies": {
      "get": {
        "summary": "List discrepancies with advanced filters",
        "responses": {
          "200": {
            "description": "Paginated list"
          }
        }
      }
    },
    "/discrepancies/{discrepancy_id}/resolve": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DiscrepancyId"
        }
      ],
      "post": {
        "summary": "Resolve single discrepancy",
        "responses": {
          "200": {
            "description": "Successfully resolved"
          }
        }
      }
    },
    "/discrepancies/bulk-resolve": {
      "post": {
        "summary": "Bulk resolve discrepancies",
        "responses": {
          "200": {
            "description": "Batch operation completed"
          }
        }
      }
    },
    "/api/v1/communications/templates": {
      "get": {
        "summary": "List tenant communication templates",
        "responses": {
          "200": {
            "description": "Template versions"
          }
        }
      },
      "post": {
        "summary": "Create a draft communication template",
        "responses": {
          "201": {
            "description": "Template created"
          }
        }
      }
    },
    "/api/v1/communications/templates/{template_id}/approve": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TemplateId"
        }
      ],
      "post": {
        "summary": "Approve a communication template version",
        "responses": {
          "200": {
            "description": "Template approved"
          }
        }
      }
    },
    "/api/v1/communications/preferences/{recipient}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Recipient"
        }
      ],
      "put": {
        "summary": "Update recipient preferences and quiet hours",
        "responses": {
          "200": {
            "description": "Preferences updated"
          }
        }
      }
    },
    "/api/v1/communications/consent/{recipient}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Recipient"
        }
      ],
      "put": {
        "summary": "Grant or revoke channel consent",
        "responses": {
          "200": {
            "description": "Consent updated"
          }
        }
      }
    },
    "/api/v1/communications/otp": {
      "post": {
        "summary": "Issue an OTP challenge",
        "responses": {
          "202": {
            "description": "Challenge queued"
          }
        }
      }
    },
    "/api/v1/communications/otp/{challenge_id}/verify": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ChallengeId"
        }
      ],
      "post": {
        "summary": "Verify an OTP challenge",
        "responses": {
          "200": {
            "description": "OTP verified"
          },
          "401": {
            "description": "OTP rejected"
          }
        }
      }
    },
    "/api/v1/communications/campaigns": {
      "post": {
        "summary": "Create a bulk or scheduled campaign",
        "responses": {
          "202": {
            "description": "Campaign queued"
          }
        }
      }
    },
    "/api/v1/communications/analytics": {
      "get": {
        "summary": "Get tenant communication delivery analytics",
        "responses": {
          "200": {
            "description": "Status and channel counts"
          }
        }
      }
    },
    "/api/v1/communications/search": {
      "get": {
        "summary": "Search tenant notifications",
        "responses": {
          "200": {
            "description": "Matching notifications"
          }
        }
      }
    },
    "/api/v1/communications/export": {
      "get": {
        "summary": "Export tenant communications as CSV",
        "responses": {
          "200": {
            "description": "CSV export"
          }
        }
      }
    },
    "/incidents/filters/presets": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "summary": "List tenant discrepancy and incident filter presets",
        "description": "Returns the built-in `critical_open`, `needs_review`, and `all` presets, overlaid with presets persisted for the resolved tenant. The current handler falls back to tenant id `default` when no tenant context is resolved; production callers must ensure an authenticated tenant context is present. This GET operation reads presets and does not create or update a custom preset.",
        "x-required-permission": "read:discrepancies",
        "responses": {
          "200": {
            "description": "Tenant filter presets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "presets": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "presets"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "tags": [
          "Incidents"
        ],
        "summary": "Create or replace a tenant filter preset",
        "description": "Accepts an optional JSON object with optional `name` and `filters` fields. The name defaults to `custom_preset` when omitted or empty; a whitespace-only name is rejected after trimming. `filters` defaults to an empty object. The handler upserts by resolved tenant and preset name and returns HTTP 201 with `status: saved` and the merged preset map. If no tenant context is resolved, the current handler falls back to tenant id `default`. The route decorator requires `read:discrepancies`; when API authentication is required, the write path also checks `write:discrepancies`.",
        "x-required-permission": "read:discrepancies",
        "x-additional-required-permissions": [
          "write:discrepancies"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "filters": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Preset persisted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "saved"
                      ]
                    },
                    "presets": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "status",
                    "presets"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  }
}
